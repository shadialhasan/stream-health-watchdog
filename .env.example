# Stream Health Watchdog Configuration
# Author: Eng. MHD. Shadi AL-Hasan <mhd.shadi.alhasan@gmail.com>

# Target Live Stream URL (HLS / RTMP / RTSP)
STREAM_URL=https://live.example.com/hls/channel1.m3u8

# Probe interval in seconds
CHECK_INTERVAL=10

# Consecutive failures before triggering critical alert
FAILURE_THRESHOLD=3

# Telegram Bot Alerting Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# Optional: Custom Webhook URL for alerting (Slack / Discord / Webhook relay)
TELEGRAM_WEBHOOK=
